<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.RECORD_AUDIO" />

	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

	<uses-permission android:name="org.opengrind.google_oauth.permission.REQUEST_TOKEN" />
	<uses-permission android:name="org.opengrind.recaptcha.permission.MINT_TOKEN" />

	<uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
	<uses-permission android:name="android.permission.WAKE_LOCK" />

	<queries>
		<package android:name="org.opengrind.google_oauth" />
		<package android:name="org.opengrind.recaptcha" />
		<package android:name="org.opengrind.fcm" />
	</queries>

	<!-- AndroidTV support -->
	<uses-feature android:name="android.software.leanback" android:required="false" />

	<application
		android:allowBackup="false"
		android:dataExtractionRules="@xml/data_extraction_rules"
		android:enableOnBackInvokedCallback="true"
		android:icon="@mipmap/ic_launcher"
		android:label="@string/app_name"
		android:theme="@style/Theme.open_grind"
		android:usesCleartextTraffic="${usesCleartextTraffic}">
		<activity
			android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
			android:launchMode="singleTask"
			android:label="@string/main_activity_title"
			android:name=".MainActivity"
			android:exported="true" />

		<!--
			The launcher entry is an alias so the icon and name can be swapped at
			runtime (Settings > App > Discreet app icon). Exactly one is enabled;
			AppIconPlugin.kt flips them. Keep the names in sync with it.
		-->
		<activity-alias
			android:name=".LauncherDefault"
			android:targetActivity=".MainActivity"
			android:enabled="true"
			android:exported="true"
			android:icon="@mipmap/ic_launcher"
			android:label="@string/app_name">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
				<!-- AndroidTV support -->
				<category android:name="android.intent.category.LEANBACK_LAUNCHER" />
			</intent-filter>
		</activity-alias>

		<activity-alias
			android:name=".LauncherCalculator"
			android:targetActivity=".MainActivity"
			android:enabled="false"
			android:exported="true"
			android:icon="@mipmap/ic_disguise_calculator"
			android:label="@string/disguise_calculator">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity-alias>

		<activity-alias
			android:name=".LauncherNotes"
			android:targetActivity=".MainActivity"
			android:enabled="false"
			android:exported="true"
			android:icon="@mipmap/ic_disguise_notes"
			android:label="@string/disguise_notes">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity-alias>

		<activity-alias
			android:name=".LauncherWeather"
			android:targetActivity=".MainActivity"
			android:enabled="false"
			android:exported="true"
			android:icon="@mipmap/ic_disguise_weather"
			android:label="@string/disguise_weather">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity-alias>

		<activity-alias
			android:name=".LauncherClock"
			android:targetActivity=".MainActivity"
			android:enabled="false"
			android:exported="true"
			android:icon="@mipmap/ic_disguise_clock"
			android:label="@string/disguise_clock">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity-alias>

		<activity
			android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
			android:label="@string/main_activity_title"
			android:name=".FacebookOauthActivity"
			android:exported="false"
			android:excludeFromRecents="true" />

		<activity
			android:name=".TokenHandoffActivity"
			android:exported="true"
			android:excludeFromRecents="true"
			android:persistableMode="persistNever"
			android:taskAffinity=""
			android:theme="@android:style/Theme.Translucent.NoTitleBar" />

		<service
			android:name="org.opengrind.update.TransferService"
			android:exported="false"
			android:stopWithTask="false"
			android:foregroundServiceType="dataSync" />

		<receiver
			android:name="org.opengrind.update.InstallResultReceiver"
			android:exported="false" />

		<service
			android:name="org.opengrind.push.PushPollService"
			android:exported="false"
			android:permission="android.permission.BIND_JOB_SERVICE" />

		<receiver
			android:name="org.opengrind.push.PushReceiver"
			android:exported="true">
			<intent-filter>
				<action android:name="org.opengrind.fcm.action.MESSAGE" />
				<action android:name="org.opengrind.fcm.action.NEW_TOKEN" />
			</intent-filter>
		</receiver>

		<provider
			android:name="androidx.core.content.FileProvider"
			android:authorities="${applicationId}.fileprovider"
			android:exported="false"
			android:grantUriPermissions="true">
			<meta-data
				android:name="android.support.FILE_PROVIDER_PATHS"
				android:resource="@xml/file_paths" />
		</provider>
	</application>
    <!-- ANDROID FS PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
    
    <!-- ANDROID FS PLUGIN. AUTO-GENERATED. DO NOT REMOVE. -->
</manifest>